<div id="<%= dom_id post %>">
  <p>
    <strong>Title:</strong>
    <%= post.title %>
  </p>

  <p>
    <strong>Content:</strong>
    <%= post.content %>
  </p>

  <p>
    <strong>Cover image:</strong>
    <%= post.cover_image %>
  </p>

  <p>
    <strong>Views:</strong>
    <%= post.views %>
  </p>

  <p>
    <strong>Category:</strong>
    <%= post.category_id %>
  </p>

</div>
