<div id="<%= dom_id auction %>">
  <p>
    <strong>Titre:</strong>
    <%= auction.titre %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= auction.description %>
  </p>

  <p>
    <strong>Prix depart:</strong>
    <%= auction.prix_depart %>
  </p>

  <p>
    <strong>Prix actuel:</strong>
    <%= auction.prix_actuel %>
  </p>

  <p>
    <strong>Nombre mises:</strong>
    <%= auction.nombre_mises %>
  </p>

  <p>
    <strong>Statut:</strong>
    <%= auction.statut %>
  </p>

  <p>
    <strong>Debut:</strong>
    <%= auction.debut %>
  </p>

  <p>
    <strong>Fin:</strong>
    <%= auction.fin %>
  </p>

  <p>
    <strong>Localisation:</strong>
    <%= auction.localisation %>
  </p>

  <p>
    <strong>User:</strong>
    <%= auction.user_id %>
  </p>

</div>
