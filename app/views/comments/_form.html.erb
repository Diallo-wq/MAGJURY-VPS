<!-- app/views/comments/_form.html.erb -->
<%= form_with model: [post, Comment.new], html: { class: 'comment-form', 'data-parent-id': parent_id  } do |f| %>

  <% if !user_signed_in? %>
    <div class="row">
      <div class="col-md-6"><%= f.text_field :guest_name, class: 'form-control', placeholder: 'Votre nom', required: true %></div>
      <div class="col-md-6"><%= f.email_field :guest_email, class: 'form-control', placeholder: 'Votre email', required: true %></div>
    </div>
  <% end %>

  <%= f.hidden_field :parent_id, value: parent_id %>
  <%= f.text_area :body, class: 'form-control', rows: 4, placeholder: 'Votre commentaire…', required: true %>

  <button type="submit" class="btn btn-warning mt-2" data-turbo="false">Publier le commentaire</button>
 
<% end %>