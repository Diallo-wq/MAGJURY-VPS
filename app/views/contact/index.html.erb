    <!-- Bootstrap & JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Valeurs sorties côté serveur (échappées une fois, pas besoin de JSON.stringify)
        const CONTACT_TEL1  = "<%= j SiteSetting.current.tel1.to_s %>";
        const CONTACT_TEL2  = "<%= j SiteSetting.current.tel2.to_s %>";
        const CONTACT_EMAIL = "<%= j SiteSetting.current.site_email.to_s %>";
        const CONTACT_WA    = "<%= j SiteSetting.current.whatsapp.to_s %>";

        // Fonctions de contact
        function callNumber() {
            if (!CONTACT_TEL1) return;
            if (confirm(`Appeler le ${CONTACT_TEL1} ?`)) {
            window.location.href = `tel:${CONTACT_TEL1.replace(/\s/g,'')}`;
            }
        }

        function callEmergency() {
            if (!CONTACT_TEL2) return;
            if (confirm(`Appeler le numéro d'urgence 24h/24 (${CONTACT_TEL2}) ?`)) {
            window.location.href = `tel:${CONTACT_TEL2.replace(/\s/g,'')}`;
            }
        }

        function sendEmail() {
            if (!CONTACT_EMAIL) return;
            const subject = "Demande d'information";
            const body    = "Bonjour,\n\nJ'aimerais obtenir des informations concernant...";
            window.location.href = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        }

        function openWhatsApp() {
            if (!CONTACT_WA) return;
            const msg = "Bonjour, je souhaite obtenir des informations sur vos services juridiques.";
            window.open(`https://wa.me/${CONTACT_WA.replace(/\D/g,'')}?text=${encodeURIComponent(msg)}`, '_blank');
        }


