        <div class="container">
            <!-- Titre de Section -->
            <div class="section-title">
                <span class="title">Contributions</span>
                <h3>Nos experts <span>contributeurs</span> sur MAGJURY</h3>
            </div>
            
            <!-- Indicateur de scroll pour mobile -->
            <div class="scroll-indicator">
                <svg viewBox="0 0 24 24" fill="none">
                    <path d="M7 13l5 5 5-5M7 6l5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Glissez pour naviguer
            </div>

            <!-- Slider des Experts -->
            <div class="team-slider">
                <div class="team-slider-container" id="sliderContainer">
                    <div class="team-slider-track" id="sliderTrack">
                        <!-- Expert 1 -->
						<% User.contributors.each do |user| %>
                        <div class="team-card">
                            <div class="team-specialty"><%= user.domaine %></div>
                            <div class="team-image">
                                <%= image_tag user.profile.attached? ? user.profile : "team-1.jpg", class: "img-fluid" %>
                                <div class="team-overlay">
                                    <div class="team-social">
                                        <% user.social_links.each do |platform, url| %>
											<%= link_to url, target: "_blank", class: "social-link", aria: { label: platform } do %>
