            </div>
        </div>
    </section>
  <%end%>
   

	<!-- End Team Section -->
	
	<%if @products.any?%>
	<section class="boutique-section">
		<div class="boutique-overlay"></div>
		<div class="container">
			<div class="boutique-header">
				<!-- Titre de Section -->
				<div class="section-title">
					<span class="title">NOTRE BOUTIQUE</span>
					<h2>MAGJURY met à votre disposition une gamme variée <span>d'œuvres</span> Juridiques et Judiciaires</h2>
				</div>
			</div>

			<!-- Produits -->
			<div class="produits-grid">
				<!-- Produit 1 -->
				
				<% @products.each do |product| %>
				<div class="produit-card">
					<div class="produit-badge"><%= product.product_category.name %></div>
					<div class="produit-image">
						<%= image_tag product.image.attached? ? product.image : "livre1.jpg",
                    	alt: product.title, class: "produit-img"  %>
						<div class="produit-overlay">
							<% whatsapp_nb = SiteSetting.current.whatsapp.presence || "0164427200" %>
								<%= link_to "https://wa.me/#{whatsapp_nb.gsub(/\D/,'')}?text=#{u("Bonjour, je suis intéressé par le produit : #{product.title} - #{product_url(product)}")}",
											target: "_blank",
											class: "btn-ajouter-panier" do %>
								<i class="bi bi-whatsapp"></i> commander
							<% end %>
							<%= link_to product_path(product), class: "btn-details" do %>
								<i class="bi bi-eye"></i> Voir détails
							<% end %>
						</div>
					</div>
					<div class="produit-content">
						<h3 class="produit-titre">
							<%= link_to product.title, product_path(product) %>
						</h3>
						<span class="produit-categorie"><%= raw(truncate(strip_tags(product.description), length: 60)) %></span>
						
						<div class="produit-prix">
							<span class="prix-actuel"><%= number_to_currency(product.current_price, unit: devise) %></span>
							<% if product.reduced_price.present? && product.reduced_price > 0 %>
								<span class="prix-original"><%= number_to_currency(product.price, unit: devise) %></span>
							<% end %>
						</div>
					
					</div>
				</div>
				<%end%>
			</div>

			<!-- Bouton Voir Plus -->
			<div class="boutique-footer">
				<a href="<%=boutique_path%>" class="btn-boutique">
					<span>Découvrir tous nos produits</span>
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none">
						<path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>
				</a>
			</div>
		</div>
	</section>

<%end%>


<%= render 'layouts/home_footer' %>
<script>
// Animation au scroll
document.addEventListener('DOMContentLoaded', function() {
    const produitCards = document.querySelectorAll('.produit-card');
    
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.style.animationPlayState = 'running';
            }
        });
    }, { threshold: 0.1 });

    produitCards.forEach(card => {
        observer.observe(card);
    });
});
</script>
	

	


	
</div>
<!--End pagewrapper-->

