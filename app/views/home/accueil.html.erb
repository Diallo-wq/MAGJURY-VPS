             <source src="<%= asset_path('hero_video.mp4') %>" type="video/mp4">
            <!-- Fallback image si la vidéo ne charge pas -->
            <%= image_tag 'bg-loi.jpg' %>
        </video>
        
        <!-- Overlay sombre -->
        <div class="banner-overlay"></div>
        
        <!-- Contenu -->
        <div class="banner-content">
            <span class="banner-subtitle">Démarrez avec MAGJURY</span>
            <h1 class="banner-title">
                Nous sommes ici pour la protection contre <br>
                 toutes formes de <span>violences</span>
            </h1>
            <p class="banner-description">
                Votre partenaire de confiance pour la défense de vos droits et 
