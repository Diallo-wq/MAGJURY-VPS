<!-- app/views/products/index.html.erb -->
<%= content_for :title, "Admin - Produits" %>

<section class="admin-header bg-dark text-white py-4">
  <div class="container">
    <h1 class="mb-0">Gestion des produits</h1>
  </div>
</section>

<div class="container my-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <%= link_to "➕ Nouveau produit", new_product_path, class: "btn btn-primary btn-sm" %>
    <span class="badge bg-secondary"><%= @products.count %> produits</span>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class="table-light">
        <tr>
          <th>Image</th>
          <th>Titre</th>
          <th>Catégorie</th>
          <th>Prix</th>
          <th>Statut</th>
          <th>Stock</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @products.each do |product| %>
          <tr>
            <td>
              <%= image_tag product.image.attached? ? product.image : "https://images.unsplash.com/photo-1560518883-ce09059eeffa?ixlib=rb-4.0.3&auto=format&fit=crop&w=100&q=80",
                            class: "rounded", width: 60, alt: product.title %>
            </td>
            <td class="fw-bold"><%= product.title %></td>
            <td><%= product.product_category&.name || "—" %></td>
            <td><%= number_to_currency(product.current_price, unit: devise) %></td>
            <td><%= render "products/badge_status", status: product.status %></td>
            <td><%= product.stock %></td>
            <td>
              <div class="btn-group btn-group-sm">
                <%= link_to "👁", product_path(product), class: "btn btn-outline-primary btn-sm" %>
                <%= link_to "✏", edit_product_path(product), class: "btn btn-outline-secondary btn-sm" %>
                <%= button_to "🗑", product_path(product), method: :delete,
                              form: { data: { turbo_confirm: "Supprimer ce produit ?" } },
                              class: "btn btn-outline-danger btn-sm" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @products.empty? %>
    <div class="text-center py-5">
      <p class="text-muted fs-5">Aucun produit pour l’instant.</p>
      <%= link_to "Créer le premier", new_product_path, class: "btn btn-primary btn-lg" %>
    </div>
  <% end %>
</div>