<!-- app/views/job_offers/index.html.erb (admin) -->
<section class="admin-header bg-dark text-white py-4">
  <div class="container"><h1 class="mb-0">Offres d’emploi</h1></div>
</section>
<div class="container my-4">
  <%= link_to "➕ Nouvelle offre", new_job_offer_path, class: "btn btn-primary mb-3" %>
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class="table-light"><tr><th>Titre</th><th>Entreprise</th><th>Contrat</th><th>Statut</th><th>Actions</th></tr></thead>
      <tbody>
        <% @job_offers.each do |offer| %><tr>
          <td><%= offer.title %></td><td><%= offer.company %></td><td><%= offer.contract_type.humanize %></td>
          <td><span class="badge bg-<%= offer.badge_color %>"><%= offer.active.humanize %></span></td>
          <td><div class="btn-group btn-group-sm"><%= link_to "✏", edit_job_offer_path(offer), class: "btn btn-outline-primary btn-sm" %><%= button_to "🗑", job_offer_path(offer), method: :delete, form: { data: { turbo_confirm: "Supprimer ?" } }, class: "btn btn-outline-danger btn-sm" %></div></td>
        </tr><% end %>
      </tbody>
    </table>
  </div>
</div>