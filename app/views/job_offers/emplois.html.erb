<!-- app/views/job_offers/index.html.erb -->
<%= content_for :title, "Offres d’emploi | MagJury" %>
<%= render 'layouts/home_header' %>
    <style>
        :root {
            --magjury-gold: #c9a96e;
            --magjury-gold-light: #e6d6b8;
            --magjury-gold-dark: #a8874c;
            --magjury-dark: #0a0a12;
            --magjury-dark-light: #1a1a24;
            --magjury-light: #f8f9fa;
            --magjury-gray: #e9ecef;
            --success: #28a745;
            --warning: #ffc107;
            --info: #17a2b8;
            --danger: #dc3545;
        }

        body {
            background-color: var(--magjury-light);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.7;
        }

        /* Header */
        .boutique-header {
            background: linear-gradient(135deg, var(--magjury-dark) 0%, var(--magjury-dark-light) 100%);
            color: white;
            padding: 80px 0 40px;
            position: relative;
            overflow: hidden;
        }

        .boutique-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000" opacity="0.03"><path fill="%23c9a96e" d="M500 100c110 0 200 90 200 200s-90 200-200 200-200-90-200-200 90-200 200-200zm0-100c165 0 300 135 300 300s-135 300-300 300-300-135-300-300 135-300 300-300z"/></svg>');
            background-size: 200px;
        }

        .header-content {
            position: relative;
            z-index: 2;
        }

        /* Header */
        .jobs-header {
            background: linear-gradient(135deg, var(--magjury-dark) 0%, var(--magjury-dark-light) 100%);
            color: white;
            padding: 100px 0 60px;
            position: relative;
            overflow: hidden;
        }

        .jobs-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000" opacity="0.03"><path fill="%23c9a96e" d="M500 100c110 0 200 90 200 200s-90 200-200 200-200-90-200-200 90-200 200-200zm0-100c165 0 300 135 300 300s-135 300-300 300-300-135-300-300 135-300 300-300z"/></svg>');
            background-size: 200px;
        }

        .header-content {
            position: relative;
            z-index: 2;
        }

        /* Navigation */
        .jobs-nav {
            background: white;
            box-shadow: 0 2px 20px rgba(0, 0, 0, 0.1);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .nav-categories {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            justify-content: center;
            padding: 15px 0;
        }

        .category-btn {
            background: transparent;
            border: 2px solid var(--magjury-gold);
            color: var(--magjury-gold);
            padding: 8px 20px;
            border-radius: 25px;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .category-btn:hover,
        .category-btn.active {
            background: var(--magjury-gold);
            color: white;
        }

        /* Filtres */
        .filters-section {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
            margin-bottom: 30px;
        }

        .filter-group {
            margin-bottom: 20px;
        }

        .filter-group h6 {
            font-weight: 600;
            margin-bottom: 15px;
            color: var(--magjury-dark);
        }

        .filter-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .filter-tag {
            background: var(--magjury-gray);
            color: #495057;
            padding: 6px 12px;
            border-radius: 15px;
            font-size: 0.8rem;
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .filter-tag.active {
            background: var(--magjury-gold);
            color: white;
        }

        /* Offres Grid */
        .jobs-grid {
            padding: 30px 0;
        }

        .job-card {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
            height: 100%;
            margin-bottom: 25px;
            border-left: 4px solid transparent;
            position: relative;
        }

        .job-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15);
            border-left-color: var(--magjury-gold);
        }

        .job-card.featured {
            border-left-color: var(--success);
        }

        .job-card.urgent {
            border-left-color: var(--danger);
        }

        .job-badge {
            position: absolute;
            top: 15px;
            right: 15px;
            padding: 6px 12px;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            z-index: 2;
        }

        .badge-featured {
            background: var(--success);
            color: white;
        }

        .badge-urgent {
            background: var(--danger);
            color: white;
        }

        .badge-new {
            background: var(--info);
            color: white;
        }

        .job-header {
            padding: 25px 25px 15px;
            border-bottom: 1px solid var(--magjury-gray);
        }

        .job-title {
            font-size: 1.3rem;
            font-weight: 700;
            margin-bottom: 10px;
            color: var(--magjury-dark);
        }

        .job-title a {
            color: inherit;
            text-decoration: none;
        }

        .job-title a:hover {
            color: var(--magjury-gold);
        }

        .job-company {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 15px;
        }

        .company-logo {
            width: 40px;
            height: 40px;
            border-radius: 8px;
            background: var(--magjury-gold);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 0.9rem;
        }

        .company-info h5 {
            margin: 0;
            font-size: 1rem;
        }

        .company-info span {
            font-size: 0.85rem;
            color: #6c757d;
        }

        .job-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            font-size: 0.9rem;
            color: #6c757d;
        }

        .meta-item {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .job-content {
            padding: 20px 25px;
        }

        .job-description {
            color: #6c757d;
            margin-bottom: 20px;
            line-height: 1.6;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .job-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 20px;
        }

        .job-tag {
            background: var(--magjury-gray);
            color: #495057;
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 0.75rem;
            text-decoration: none;
        }

        .job-footer {
            padding: 15px 25px;
            background: #f8f9fa;
            border-top: 1px solid var(--magjury-gray);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .job-salary {
            font-weight: 600;
            color: var(--magjury-dark);
        }

        /* Stats Section */
        .stats-section {
            background: white;
            padding: 60px 0;
            margin: 60px 0;
        }

        .stat-item {
            text-align: center;
            padding: 30px 20px;
        }

        .stat-number {
            font-size: 3rem;
            font-weight: 800;
            color: var(--magjury-gold);
            line-height: 1;
            margin-bottom: 10px;
        }

        .stat-label {
            font-size: 1.1rem;
            color: var(--magjury-dark);
            font-weight: 600;
        }

        /* Pourquoi Nous Section */
        .why-us-section {
            background: linear-gradient(135deg, var(--magjury-dark) 0%, var(--magjury-dark-light) 100%);
            color: white;
            padding: 80px 0;
            position: relative;
            overflow: hidden;
        }

        .why-us-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000" opacity="0.03"><path fill="%23c9a96e" d="M500 100c110 0 200 90 200 200s-90 200-200 200-200-90-200-200 90-200 200-200zm0-100c165 0 300 135 300 300s-135 300-300 300-300-135-300-300 135-300 300-300z"/></svg>');
            background-size: 200px;
        }

        .benefit-item {
            text-align: center;
            padding: 30px 20px;
            position: relative;
            z-index: 2;
        }

        .benefit-icon {
            width: 80px;
            height: 80px;
            background: rgba(201, 169, 110, 0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            color: var(--magjury-gold);
            font-size: 2rem;
        }

        .benefit-title {
            font-size: 1.3rem;
            font-weight: 600;
            margin-bottom: 15px;
        }

        .benefit-description {
            opacity: 0.9;
            line-height: 1.6;
        }

        /* Processus Section */
        .process-section {
            padding: 80px 0;
            background: white;
        }

        .process-step {
            text-align: center;
            padding: 30px 20px;
        }

        .step-number {
            width: 60px;
            height: 60px;
            background: var(--magjury-gold);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0 auto 20px;
        }

        .step-title {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 15px;
            color: var(--magjury-dark);
        }

        .step-description {
            color: #6c757d;
            line-height: 1.6;
        }

        /* CTA Section */
        .cta-section {
            background: linear-gradient(135deg, var(--magjury-gold) 0%, var(--magjury-gold-dark) 100%);
            color: white;
            padding: 80px 0;
            text-align: center;
        }

        .cta-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 20px;
        }

        .cta-description {
            font-size: 1.2rem;
            margin-bottom: 30px;
            opacity: 0.9;
        }

        /* Footer */
        .jobs-footer {
            background: var(--magjury-dark);
            color: white;
            padding: 60px 0 30px;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .jobs-header {
                padding: 80px 0 40px;
            }
            
            .nav-categories {
                justify-content: flex-start;
                overflow-x: auto;
                padding-bottom: 10px;
            }
            
            .job-footer {
                flex-direction: column;
                gap: 15px;
                text-align: center;
            }
            
            .cta-title {
                font-size: 2rem;
            }
        }

        @media (max-width: 576px) {
            .filters-section {
                padding: 20px;
            }
            
            .job-header {
                padding: 20px 20px 15px;
            }
            
            .stat-number {
                font-size: 2.5rem;
            }
        }

        /* Animations */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .job-card {
            animation: fadeInUp 0.6s ease forwards;
        }
    </style>

   <%= content_for :title, "Offres d’emploi | MagJury" %>

<!-- Header -->
<header class="boutique-header mt-5">
  <div class="container">
    <div class="header-content text-center">
      <h1 class="display-4 fw-bold mb-3">Offres d’emploi MAGJURY</h1>
      <p class="lead mb-4">Découvrez les meilleures opportunités juridiques et judiciaires</p>
      <div class="search-bar mx-auto" style="max-width: 500px;">
        <%= form_with url: emplois_path, method: :get, local: false, html: { class: "input-group" } do |f| %>
          <%= f.text_field :q, value: params[:q], class: "form-control form-control-lg", placeholder: "Rechercher un poste, une ville..." %>
          <%= f.submit "🔍", class: "btn btn-warning" %>
        <% end %>
      </div>
    </div>
  </div>
</header>
<%if @job_offers.any? %>
<!-- Main Content -->
<main class="container my-5">
  <div class="row">
    <!-- Sidebar Filtres -->
    <div class="col-lg-3">
      <%= form_with url: emplois_path, method: :get, local: false, html: { class: "filters-section" } do |f| %>

        <!-- Localisation -->
        <div class="filter-group">
          <h6>Localisation</h6>
          <div class="filter-tags">
            <%= link_to "Toutes", emplois_path, class: "filter-tag #{'active' if params[:location].blank?}" %>
            <% ["Paris", "Lyon", "Marseille", "Toulouse", "Télétravail"].each do |city| %>
              <%= link_to city, emplois_path(location: city), class: "filter-tag #{'active' if params[:location] == city}" %>
            <% end %>
          </div>
        </div>

        <!-- Type de contrat -->
        <div class="filter-group">
          <h6>Type de contrat</h6>
          <div class="filter-tags">
            <%= link_to "Tous", emplois_path, class: "filter-tag #{'active' if params[:contract_type].blank?}" %>
            <% JobOffer.contract_types.keys.each do |type| %>
              <%= link_to JobOffer.human_attribute_name("contract_type.#{type}"), emplois_path(contract_type: type), class: "filter-tag #{'active' if params[:contract_type] == type}" %>
            <% end %>
          </div>
        </div>

        <!-- Télétravail -->
        <div class="filter-group">
          <h6>Options</h6>
          <div class="form-check">
            <%= check_box_tag "remote", "1", params[:remote] == "1", class: "form-check-input", onchange: "this.form.requestSubmit()" %>
            <%= label_tag "remote", "Télétravail uniquement", class: "form-check-label" %>
          </div>
        </div>

        <%= submit_tag "Appliquer les filtres", class: "btn btn-warning w-100 mt-3" %>
      <% end %>

      
    </div>

    <!-- Offres Grid -->
    <div class="col-md-9">
      <!-- En-tête -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h4 class="fw-bold mb-0" id="jobs">Offres d’emploi</h4>
          <p class="text-muted mb-0"><%= pluralize(@job_offers.size, "offre") %> correspondant à vos critères</p>
        </div>
        <div class="d-flex gap-3">
          <%= select_tag "sort", options_for_select([["Trier par : Pertinence", ""], ["Date de publication", "date_desc"], ["Salaire décroissant", "salary_desc"]], params[:sort]),
                         class: "form-select", style: "width: auto;", onchange: "this.form.requestSubmit()" %>
        </div>
      </div>

      <!-- Grille d’offres -->
      <div class="jobs-grid">
        <div class="row" id="jobsContainer">
          <%= render partial: "job_offers/card", collection: @job_offers, as: :offer %>
        </div>
      </div>
    </div>
  </div>
</main>

<%end%>

 <% if @job_offers.empty? %>
    <div class="text-center py-5">
      <i class="bi bi-inbox display-1 text-muted"></i>
      <p class="text-muted fs-5">Aucune enchère ne correspond à vos critères.</p>
    </div>
  <% end %>

    <!-- Stats Section -->
    <section class="stats-section">
        <div class="container">
            <div class="row">
                <div class="col-md-3">
                    <div class="stat-item">
                        <div class="stat-number">150+</div>
                        <div class="stat-label">Collaborateurs</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-item">
                        <div class="stat-number">12</div>
                        <div class="stat-label">Bureaux</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-item">
                        <div class="stat-number">95%</div>
                        <div class="stat-label">Satisfaction</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-item">
                        <div class="stat-number">25</div>
                        <div class="stat-label">Spécialités</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Pourquoi Nous Section -->
    <section class="why-us-section">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="display-5 fw-bold mb-3">Pourquoi rejoindre MAGJURY ?</h2>
                <p class="lead">Découvrez les avantages de faire carrière dans notre groupe</p>
            </div>
            
            <div class="row">
                <div class="col-lg-4">
                    <div class="benefit-item">
                        <div class="benefit-icon">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <h4 class="benefit-title">Évolution de Carrière</h4>
                        <p class="benefit-description">Plans de carrière personnalisés et opportunités d'évolution au sein de notre groupe en croissance.</p>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="benefit-item">
                        <div class="benefit-icon">
                            <i class="fas fa-graduation-cap"></i>
                        </div>
                        <h4 class="benefit-title">Formation Continue</h4>
                        <p class="benefit-description">Programmes de formation réguliers et accès à nos ressources juridiques exclusives.</p>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="benefit-item">
                        <div class="benefit-icon">
                            <i class="fas fa-handshake"></i>
                        </div>
                        <h4 class="benefit-title">Projets Prestigieux</h4>
                        <p class="benefit-description">Travaillez sur des dossiers complexes et innovants avec des clients de renommée internationale.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Processus Section -->
    <section class="process-section">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="display-5 fw-bold mb-3">Processus de Recrutement</h2>
                <p class="lead">Un parcours de recrutement transparent et efficace</p>
            </div>
            
            <div class="row">
                <div class="col-lg-3 col-md-6">
                    <div class="process-step">
                        <div class="step-number">1</div>
                        <h4 class="step-title">Candidature</h4>
                        <p class="step-description">Dépôt de candidature en ligne avec CV et lettre de motivation.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="process-step">
                        <div class="step-number">2</div>
                        <h4 class="step-title">Pré-sélection</h4>
                        <p class="step-description">Analyse de votre profil sous 48h et retour systématique.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="process-step">
                        <div class="step-number">3</div>
                        <h4 class="step-title">Entretiens</h4>
                        <p class="step-description">Rencontres avec nos équipes (RH, technique, direction).</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="process-step">
                        <div class="step-number">4</div>
                        <h4 class="step-title">Intégration</h4>
                        <p class="step-description">Processus d'onboarding complet et accompagnement personnalisé.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
        <div class="container">
            <h2 class="cta-title">Prêt à rejoindre notre équipe ?</h2>
            <p class="cta-description">Postulez dès maintenant et développez votre carrière dans l'expertise juridique</p>
            <div class="d-flex gap-3 justify-content-center flex-wrap">
                <a href="#jobs" class="btn btn-light btn-lg">
                    <i class="fas fa-briefcase me-2"></i>
                    Voir les offres
                </a>
                <button class="btn btn-outline-light btn-lg" data-bs-toggle="modal" data-bs-target="#contactModal">
                    <i class="fas fa-envelope me-2"></i>
                    Candidature spontanée
                </button>
            </div>
        </div>
    </section>

<%= render 'layouts/home_footer' %>

    <!-- Modal Détail Offre -->
