                            <span class="badge bg-secondary">Paris 8ème</span>
                            <span class="badge bg-success">45K - 55K /an</span>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6>Entreprise</h6>
                            <p><strong>MAGJURY Corporate</strong><br>
                            Département Juridique<br>
                            123 Avenue des Champs-Élysées, 75008 Paris</p>
