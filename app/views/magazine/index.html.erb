<style>

.magazine-hero-section {
  padding: 2rem 0;
  background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
  
  .container {
    position: relative;
    z-index: 2;
  }
}

.magazine-hero-slider {
  position: relative;
  height: 500px; 
  border-radius: 25px;
  overflow: hidden;
  box-shadow: 
    0 25px 50px -12px rgba(0, 0, 0, 0.25),
    0 0 0 1px rgba(255, 255, 255, 0.1),
    inset 0 1px 0 rgba(255, 255, 255, 0.1);
  
  &::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.1) 0%,
      transparent 50%,
      rgba(255, 255, 255, 0.05) 100%
    );
    z-index: 1;
    pointer-events: none;
    border-radius: 25px;
  }
  
  .carousel-item {
    height: 500px;
    position: relative;
    
    &::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(
        135deg,
        rgba(0, 0, 0, 0.7) 0%,
        rgba(0, 0, 0, 0.4) 50%,
        rgba(0, 0, 0, 0.2) 100%
      );
      z-index: 1;
      border-radius: 25px;
    }
  }
  
  .carousel-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 10s ease-in-out;
    border-radius: 25px;
  }
  
  .carousel-item.active .carousel-image {
    transform: scale(1.1);
  }
}

.magazine-slider-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 2;
  padding: 3rem 4rem;
  color: white;
  background: linear-gradient(
    transparent 0%,
    rgba(0, 0, 0, 0.3) 30%,
    rgba(0, 0, 0, 0.6) 70%,
    rgba(0, 0, 0, 0.8) 100%
  );
  border-radius: 25px;
  
  .magazine-slider-badge {
    background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
    color: white;
    padding: 0.6rem 1.75rem;
    border-radius: 30px;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    display: inline-block;
    margin-bottom: 1.25rem;
    box-shadow: 
      0 8px 20px rgba(255, 107, 107, 0.4),
      0 0 0 1px rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  
  .magazine-slider-title {
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1.25rem;
    text-shadow: 
      2px 2px 4px rgba(0, 0, 0, 0.5),
      0 0 30px rgba(0, 0, 0, 0.3);
    
    a {
      color: white;
      text-decoration: none;
      transition: all 0.3s ease;
      
      &:hover {
        color: #ffd700;
        text-shadow: 
          2px 2px 4px rgba(0, 0, 0, 0.7),
          0 0 20px rgba(255, 215, 0, 0.3);
      }
    }
  }
  
  .magazine-slider-excerpt {
    font-size: 1.2rem;
    line-height: 1.6;
    margin-bottom: 1.75rem;
    opacity: 0.95;
    max-width: 700px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
    font-weight: 400;
  }
  
  .magazine-slider-meta {
    display: flex;
    align-items: center;
    gap: 2rem;
    font-size: 1rem;
    opacity: 0.9;
    
    span {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.5rem 1rem;
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(10px);
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.2);
      transition: all 0.3s ease;
      
      &:hover {
        background: rgba(255, 255, 255, 0.2);
        transform: translateY(-2px);
      }
    }
  }
}


.magazine-slider-controls {
  .carousel-control-prev,
  .carousel-control-next {
    width: 70px;
    height: 70px;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(15px);
    border-radius: 50%;
    top: 50%;
    transform: translateY(-50%);
    margin: 0 3rem;
    opacity: 0;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    border: 2px solid rgba(255, 255, 255, 0.3);
    z-index: 1000;
    
    &:hover {
      background: rgba(255, 255, 255, 0.25);
      transform: translateY(-50%) scale(1.15);
      border-color: rgba(255, 255, 255, 0.5);
    }
    
    .carousel-control-prev-icon,
    .carousel-control-next-icon {
      width: 25px;
      height: 25px;
      filter: brightness(0) invert(1);
    }
  }
  
  .carousel-control-prev {
    left: 0;
  }
  
  .carousel-control-next {
    right: 0;
  }
  
  &:hover {
    .carousel-control-prev,
    .carousel-control-next {
      opacity: 1;
    }
  }
}


.magazine-slider-indicators {
  position: absolute;
  bottom: 2.5rem;
  left: 50%;
  transform: translateX(-50%);
  z-index: 3;
  display: flex;
  gap: 0.75rem;
  
  button {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.8);
    background: transparent;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
    overflow: hidden;
    
    &::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, #fff, #ffd700);
      transition: left 0.3s ease;
    }
    
    &.active {
      border-color: #ffd700;
      transform: scale(1.3);
      
      &::before {
        left: 0;
      }
    }
    
    &:hover:not(.active) {
      background: rgba(255, 255, 255, 0.3);
      transform: scale(1.1);
    }
  }
}


@media (max-width: 768px) {
  .magazine-hero-section {
    padding: 1rem 0;
  }
  
  .magazine-hero-slider,
  .magazine-hero-slider .carousel-item {
    height: 400px; 
    border-radius: 15px; 
  }
  
  .magazine-slider-content {
    padding: 1.5rem 1.5rem 1rem; 
    border-radius: 0 0 15px 15px;
    background: linear-gradient(
      transparent 0%,
      rgba(0, 0, 0, 0.4) 20%,
      rgba(0, 0, 0, 0.7) 60%,
      rgba(0, 0, 0, 0.9) 100%
    ); 
    
    .magazine-slider-badge {
      padding: 0.4rem 1rem;
      font-size: 0.7rem;
      letter-spacing: 1px;
      margin-bottom: 0.75rem;
    }
    
    .magazine-slider-title {
      font-size: 1.4rem !important; 
      line-height: 1.2;
      margin-bottom: 0.75rem;
      text-shadow: 
        2px 2px 4px rgba(0, 0, 0, 0.8),
        0 0 20px rgba(0, 0, 0, 0.5);
    }
    
    .magazine-slider-excerpt {
      font-size: 0.85rem;
      line-height: 1.4;
      margin-bottom: 1rem;
      opacity: 0.95;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    
    .magazine-slider-meta {
      flex-wrap: wrap; 
      gap: 0.5rem;
      justify-content: flex-start;
      
      span {
        font-size: 0.75rem;
        padding: 0.35rem 0.75rem;
        gap: 0.5rem;
        background: rgba(255, 255, 255, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.3);
        
        
        flex-shrink: 0;
        margin-right: 0.5rem;
        margin-bottom: 0.25rem;
      }
    }
  }
  
  .carousel-image {
    border-radius: 15px;
  }
  
  .magazine-slider-controls {
    .carousel-control-prev,
    .carousel-control-next {
      width: 45px;
      height: 45px;
      margin: 0 0.5rem;
      opacity: 0.7; 
      
      .carousel-control-prev-icon,
      .carousel-control-next-icon {
        width: 18px;
        height: 18px;
      }
    }
  }
  
  .magazine-slider-indicators {
    bottom: 1rem;
    
    button {
      width: 10px;
      height: 10px;
      border-width: 1px;
    }
  }
}

@media (max-width: 576px) {
  .magazine-hero-slider,
  .magazine-hero-slider .carousel-item {
    height: 350px;
  }
  
  .magazine-slider-content {
    padding: 1.25rem 1.25rem 0.75rem;
    
    .magazine-slider-title {
      font-size: 1.25rem !important;
      margin-bottom: 0.5rem;
    }
    
    .magazine-slider-excerpt {
      font-size: 0.8rem;
      margin-bottom: 0.75rem;
      -webkit-line-clamp: 2; 
    }
    
    .magazine-slider-meta {
      gap: 0.25rem;
      
      span {
        font-size: 0.7rem;
        padding: 0.3rem 0.6rem;
        margin-right: 0.25rem;
      }
    }
  }
  
  .magazine-slider-controls {
    .carousel-control-prev,
    .carousel-control-next {
      width: 40px;
      height: 40px;
      margin: 0 0.25rem;
    }
  }
}


@media (max-width: 375px) {
  .magazine-hero-slider,
  .magazine-hero-slider .carousel-item {
    height: 320px;
  }
  
  .magazine-slider-content {
    padding: 1rem 1rem 0.5rem;
    
    .magazine-slider-title {
      font-size: 1.1rem !important;
    }
    
    .magazine-slider-excerpt {
      font-size: 0.75rem;
      -webkit-line-clamp: 2;
    }
    
    .magazine-slider-meta {
      span {
        font-size: 0.65rem;
        padding: 0.25rem 0.5rem;
      }
    }
  }
}


@keyframes slideUpFadeIn {
  from {
    opacity: 0;
    transform: translateY(40px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.carousel-item.active .magazine-slider-content {
  animation: slideUpFadeIn 0.8s ease-out 0.3s both;
}









.magazine-article-card {
  border: none;
  border-radius: 15px;
  overflow: hidden;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  background: white;
  height: 100%;
  
  &:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
  }
}

.magazine-article-img {
  height: 200px;
  object-fit: cover;
  transition: transform 0.4s ease;
  
  .magazine-article-card:hover & {
    transform: scale(1.08);
  }
}

.magazine-article-badge {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  padding: 0.3rem 0.8rem;
  border-radius: 8px;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}


.magazine-sidebar-card {
  border: none;
  border-radius: 15px;
  box-shadow: 0 5px 20px rgba(0, 0, 0, 0.06);
  background: white;
  overflow: hidden;
  
  .card-header {
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white;
    border: none;
    font-weight: 700;
    font-size: 1.1rem;
    padding: 1.25rem 1.5rem;
  }
}

.magazine-category-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.875rem 1rem;
  text-decoration: none;
  color: #475569;
  border-radius: 10px;
  transition: all 0.3s ease;
  border: 1px solid transparent;
  margin-bottom: 0.5rem;
  
  &:hover {
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white;
    transform: translateX(5px);
    
    .magazine-category-count {
      background: rgba(255, 255, 255, 0.2);
      color: white;
    }
  }
}

.magazine-category-count {
  background: #f1f5f9;
  color: #64748b;
  padding: 0.25rem 0.6rem;
  border-radius: 8px;
  font-size: 0.8rem;
  font-weight: 600;
  min-width: 2rem;
  text-align: center;
  transition: all 0.3s ease;
}


.magazine-tag {
  display: inline-block;
  padding: 0.5rem 1rem;
  background: linear-gradient(135deg, #f8fafc, #e2e8f0);
  color: #475569;
  text-decoration: none;
  border-radius: 25px;
  font-size: 0.85rem;
  font-weight: 500;
  transition: all 0.3s ease;
  margin: 0.25rem;
  border: 1px solid #e2e8f0;
  
  &:hover {
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
    border-color: transparent;
  }
}


.magazine-popular-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1rem;
  text-decoration: none;
  color: inherit;
  border-radius: 10px;
  transition: all 0.3s ease;
  margin-bottom: 0.5rem;
  background: #f8fafc;
  
  &:hover {
    background: white;
    transform: translateX(3px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
  }
}

.magazine-popular-rank {
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  color: white;
  width: 32px;
  height: 32px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.9rem;
  font-weight: 700;
  flex-shrink: 0;
}


.magazine-section-title {
  font-size: 2.5rem;
  font-weight: 800;
  background: linear-gradient(135deg, #2d3748, #4a5568);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  position: relative;
  padding-bottom: 1rem;
  margin-bottom: 2rem;
  
  &::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 80px;
    height: 4px;
    background: linear-gradient(135deg, #667eea, #764ba2);
    border-radius: 2px;
  }
}


@media (max-width: 768px) {
  .magazine-featured-card {
    margin-bottom: 2rem;
    
    &:hover {
      transform: translateY(-5px);
    }
  }
  
  .magazine-section-title {
    font-size: 2rem;
  }
}
</style>

<%= render 'layouts/home_header' %>


<div class="magazine-layout mt-5">
 <!-- HERO SECTION AVEC SLIDER -->
  <% if @featured.any?%>
    <section class="magazine-hero-section py-5">
      <div class="container">
        <div class="row align-items-stretch">
          <!-- Slider Principal Pleine Largeur -->
          <div class="col-12">
            <div class="magazine-hero-slider magazine-slider-controls">
              <div id="magazineHeroCarousel" class="carousel slide" data-bs-ride="carousel">
                <!-- Indicateurs -->
                <div class="magazine-slider-indicators">
                  <% @featured.each_with_index do |post, index| %>
                    <button type="button" 
                            data-bs-target="#magazineHeroCarousel" 
                            data-bs-slide-to="<%= index %>" 
                            class="<%= 'active' if index == 0 %>"
                            aria-current="<%= 'true' if index == 0 %>"
                            aria-label="Slide <%= index + 1 %>"></button>
                  <% end %>
                </div>

                <!-- Slides -->
                <div class="carousel-inner">
                  <% @featured.each_with_index do |post, index| %>
                    <div class="carousel-item <%= 'active' if index == 0 %>" data-bs-interval="5000">
                      <% if post.cover_image.attached? %>
                        <%= image_tag url_for(post.cover_image), class: "carousel-image" %>
                      <% else %>
                        <img src="https://images.unsplash.com/photo-1589391886645-d51941baf7fb?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80" 
                            class="carousel-image" alt="<%= post.title %>">
                      <% end %>
                      
                      <div class="magazine-slider-content">
                        <span class="magazine-slider-badge">★ ARTICLE VEDETTE</span>
                        <h1 class="magazine-slider-title" style="font-size: clamp(1.25rem, 5vw, 2.75rem);">
                          <%= link_to post.title, post_path(post) %>
                        </h1>
                        <p class="magazine-slider-excerpt d-none d-md-block">
                          <%= raw(truncate(strip_tags(post.content.to_s), length: 150)) %>
                        </p>
                        <div class="magazine-slider-meta">
                          <span><i class="far fa-comments"></i> <%= post.comments.count %></span>
                          <span><i class="far fa-eye"></i> <%= post.views %></span>
                          <span><i class="far fa-clock"></i> <%= time_ago_in_words(post.created_at) %></span>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>

                <!-- Contrôles -->
                <button class="carousel-control-prev" type="button" data-bs-target="#magazineHeroCarousel" data-bs-slide="prev">
                  <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                  <span class="visually-hidden">Précédent</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#magazineHeroCarousel" data-bs-slide="next">
                  <span class="carousel-control-next-icon" aria-hidden="true"></span>
                  <span class="visually-hidden">Suivant</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  <%end%>



  <!-- CONTENU PRINCIPAL -->
  <section class="py-5 bg-light">
    <div class="container">
      <div class="row">
        <!-- Sidebar -->
        <div class="col-lg-4 mb-5 mb-lg-0">
          <div class="sticky-top" style="top: 2rem;">
            
            <!-- Catégories -->
            <div class="magazine-sidebar-card card mb-4">
              <div class="card-header d-flex align-items-center">
                <i class="fas fa-folder me-2"></i>
                Catégories
              </div>
              <div class="card-body">
                <div class="d-grid gap-2">
                  <%= link_to magazine_path, class: "magazine-category-item" do %>
                    <span>Tous les articles</span>
                    <span class="magazine-category-count"><%= Post.published.count %></span>
                  <% end %>
                  
                  <% @categories.each do |category| %>
                    <%= link_to magazine_path(category_id: category.id), 
                              class: "magazine-category-item #{'active' if params[:category_id].to_i == category.id}" do %>
                      <span><%= category.name %></span>
                      <span class="magazine-category-count"><%= category.posts_count %></span>
                    <% end %>
                  <% end %>
                </div>
              </div>
            </div>

            <!-- Tags -->
            <div class="magazine-sidebar-card card mb-4">
              <div class="card-header d-flex align-items-center">
                <i class="fas fa-tags me-2"></i>
                Tags Populaires
              </div>
              <div class="card-body">
                <div class="text-center">
                  <% popular_tags = Tag.all %>
                  <% if popular_tags.any? %>
                    <% popular_tags.each do |tag| %>
                      <%= link_to tag.name, "#", class: "magazine-tag" %>
                    <% end %>
                  <% else %>
                    Aucune etiquette pour le moment
                  <% end %>
                </div>
              </div>
            </div>

            <!-- Articles Populaires -->
            <div class="magazine-sidebar-card card">
              <div class="card-header d-flex align-items-center">
                <i class="fas fa-fire me-2"></i>
                Articles Tendances
              </div>
              <div class="card-body">
                <% popular_posts = @popular_posts || @posts.limit(5) %>
                <% popular_posts.each_with_index do |post, index| %>
                  <%= link_to post_path(post), class: "magazine-popular-item" do %>
                    <span class="magazine-popular-rank"><%= index + 1 %></span>
                    <div class="flex-grow-1">
                      <h6 class="mb-1 fw-bold" style="font-size: 0.9rem;"><%= post.title %></h6>
                      <small class="text-muted">
                        <i class="far fa-eye me-1"></i><%= post.views %> vues
                      </small>
                    </div>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <!-- Articles Principaux -->
        <div class="col-lg-8">
          <h2 class="magazine-section-title mb-4">
            <%= @selected_category ? @selected_category.name : "Articles Récents" %>
          </h2>

          <% if @posts.any? %>
            <div class="row g-4">
              <% @posts.each do |post| %>
                <div class="col-md-6">
                  <div class="magazine-article-card card h-100">
                    <% if post.cover_image.attached? %>
                      <%= image_tag url_for(post.cover_image), class: "magazine-article-img card-img-top" %>
                    <% else %>
                      <img src="https://images.unsplash.com/photo-1589391886645-d51941baf7fb?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80" 
                           class="magazine-article-img card-img-top" alt="Article">
                    <% end %>
                    
                    <div class="card-body d-flex flex-column">
                      <div class="d-flex justify-content-between align-items-start mb-2">
                        <% if post.featured? %>
                          <span class="magazine-article-badge">★ Vedette</span>
                        <% else %>
                          <span></span>
                        <% end %>
                        <small class="text-muted"><%= time_ago_in_words(post.created_at) %></small>
                      </div>
                      
                      <h5 class="card-title fw-bold">
                        <%= link_to post.title, post_path(post), class: "text-decoration-none text-dark" %>
                      </h5>
                      
                      <p class="card-text text-muted flex-grow-1">
                         <%= raw(truncate(strip_tags(post.content.to_s), length: 100)) %>
                      </p>
                      
                      <div class="d-flex justify-content-between align-items-center mt-auto">
                        <div class="d-flex gap-3 text-muted small">
                          <span><i class="far fa-comments me-1"></i> <%= post.comments.count %></span>
                          <span><i class="far fa-eye me-1"></i> <%= post.views %></span>
                        </div><%= link_to "Lire →", post_path(post), class: "btn btn-sm btn-outline-primary" %>
                        
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-5">
              <div class="display-1 text-muted mb-3">📝</div>
              <h3 class="text-muted">Aucun article pour le moment</h3>
