<style>
  /* app/assets/stylesheets/services.css */
.service-hero {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}
.service-icon-xl { font-size: 4rem; }
.price-tag-xl { letter-spacing: 1px; }
.description-box { font-size: 1.1rem; line-height: 1.8; }
</style>


<!-- app/views/services/show.html.erb -->
<%= content_for :title, "#{@service.title} | Services MagJury" %>

<section class="service-hero">
  <div class="container text-center text-white py-5">
    <h1 class="display-4 fw-bold"><%= @service.title %></h1>
    <% if @service.category.present? %>
      <span class="badge bg-light text-dark fs-6"><%= @service.category.humanize %></span>
    <% end %>
  </div>
</section>

<main class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <!-- ICON / IMAGE -->
        <div class="card-header bg-transparent text-center pt-5">
          <div class="service-icon-xl mb-3">
            <% if @service.icon.present? %>
              <i class="<%= @service.icon %> fs-1 text-primary"></i>
            <% else %>
              💼
            <% end %>
          </div>
          <div class="price-tag-xl mb-3">
            <span class="fs-2 fw-bold text-primary"><%= @service.price %></span>
          </div>
        </div>

        <div class="card-body px-5 py-4">
          <h2 class="fw-bold text-center mb-4">Description détaillée</h2>
          <div class="description-box">
            <%= raw(@service.description) %>
          </div>

          <hr class="my-5">
          <div class="row text-center">
            <div class="col-6">
              <i class="bi bi-calendar-check text-primary fs-3"></i>
              <div class="mt-2 fw-bold">Créé le</div>
              <div><%= l(@service.created_at, format: :long) %></div>
            </div>
            <div class="col-6">
              <i class="bi bi-clock text-primary fs-3"></i>
              <div class="mt-2 fw-bold">Mis à jour</div>
              <div><%= l(@service.updated_at, format: :long) %></div>
            </div>
          </div>
        </div>

        <% if current_user&.admin? %>
          <div class="card-footer bg-light d-flex justify-content-end gap-2 p-3">
            <%= link_to "✏ Éditer", edit_service_path(@service), class: "btn btn-outline-primary btn-sm" %>
            <%= button_to "🗑 Supprimer", service_path(@service), method: :delete,
                          form: { data: { turbo_confirm: "Supprimer ce service ?" } },
                          class: "btn btn-outline-danger btn-sm" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</main>