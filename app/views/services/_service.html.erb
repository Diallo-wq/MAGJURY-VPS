<style>
  /* app/assets/stylesheets/services.css */
.service-hero {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.description-box {
  font-size: 1.1rem;
  line-height: 1.8;
  color: #212529;
}

.card {
  border-radius: 1rem;
}
</style>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
<%= content_for :title, "#{@service.title} | Services MagJury" %>

<!-- HERO -->
<section class="service-hero">
  <div class="container text-center text-white py-5">
    <h1 class="display-4 fw-bold"><%= @service.title %></h1>
    <p class="lead mb-0">Service proposé par MagJury</p>
  </div>
</section>

<!-- CONTENU -->
<main class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <!-- IMAGE D'ILLUSTRATION (fallback) 
        <img src="https://images.unsplash.com/photo-1556761175-4b46a572b786?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80"
             class="card-img-top" alt="<%= @service.title %>">
        -->
        <div class="card-body p-5">
          <!-- TITRE -->
          <h2 class="fw-bold text-primary mb-4"><%= @service.title %></h2>

          <!-- DESCRIPTION -->
          <div class="description-box">
            <%= simple_format(@service.description, class: "mb-0") %>
          </div>

          <!-- MÉTA-DONNÉES -->
          <hr class="my-4">
          <div class="row text-center">
            <div class="col-6">
              <i class="bi bi-calendar-check text-primary fs-4"></i>
              <div class="mt-2 fw-bold">Créé le</div>
              <div><%= l(@service.created_at, format: :long) %></div>
            </div>
            <div class="col-6">
              <i class="bi bi-clock text-primary fs-4"></i>
              <div class="mt-2 fw-bold">Mis à jour</div>
              <div><%= l(@service.updated_at, format: :long) %></div>
            </div>
          </div>
        </div>

        <!-- ACTIONS (admin ou auteur) -->
        <% if current_user&.admin? %>
          <div class="card-footer bg-light d-flex justify-content-end gap-2 p-3">
            <%= link_to "✏ Éditer", edit_service_path(@service), class: "btn btn-outline-primary btn-sm" %>
            <%= button_to "🗑 Supprimer", service_path(@service), method: :delete,
                          form: { data: { turbo_confirm: "Supprimer ce service ?" } },
                          class: "btn btn-outline-danger btn-sm" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</main>