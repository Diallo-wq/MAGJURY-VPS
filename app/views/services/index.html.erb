<!-- app/views/services/index.html.erb -->
<%= content_for :title, "Services | MagJury" %>

<section class="admin-header bg-dark text-white py-4">
  <div class="container">
    <h1 class="mb-0">Gestion des services</h1>
  </div>
</section>

<div class="container my-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <%= link_to "➕ Nouveau service", new_service_path, class: "btn btn-primary btn-sm" %>
    <span class="badge bg-secondary"><%= @services.count %> services</span>
  </div>

  <!-- TABLEAU COMPLET -->
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class="table-light">
        <tr>
          <th>#</th>
          <th>Icône</th>
          <th>Titre</th>
          <th>Description</th>
          <th>Prix</th>
          <th>Catégorie</th>
          <th>Créé le</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @services.each do |service| %>
          <tr>
            <td><%= service.id %></td>

            <!-- ICÔNE -->
            <td class="text-center">
              <% if service.icon.present? %>
                <i class="<%= service.icon %> fs-4 text-primary"></i>
              <% else %>
                💼
              <% end %>
            </td>

            <!-- TITRE -->
            <td class="fw-bold"><%= service.title %></td>

            <!-- DESCRIPTION -->
            <td>
              <div class="text-truncate" style="max-width: 300px;" title="<%= strip_tags(service.description) %>">
                <%= raw(truncate(strip_tags(service.description), length: 120)) %>
              </div>
            </td>

            <!-- PRIX + SUFFIXE -->
            <td>
              <span class="badge bg-success"><%= service.price%></span>
            </td>

            <!-- CATÉGORIE -->
            <td>
              <% if service.category.present? %>
                <span class="badge bg-secondary"><%= service.category.humanize %></span>
              <% else %>
                <span class="text-muted">—</span>
              <% end %>
            </td>

            <!-- DATE -->
            <td><%= l(service.created_at, format: :short) %></td>

            <!-- ACTIONS -->
            <td>
              <div class="btn-group btn-group-sm">
                <%= link_to "👁", service_path(service), title: "Voir", class: "btn btn-outline-primary btn-sm" %>
                <%= link_to "✏", edit_service_path(service), title: "Éditer", class: "btn btn-outline-secondary btn-sm" %>
                <%= button_to "🗑", service_path(service), method: :delete,
                              form: { data: { turbo_confirm: "Supprimer ce service ?" } },
                              class: "btn btn-outline-danger btn-sm" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @services.empty? %>
    <div class="text-center py-5">
      <i class="bi bi-inbox display-1 text-muted"></i>
      <p class="text-muted fs-5 mt-3">Aucun service pour l’instant.</p>
      <%= link_to "Créer le premier", new_service_path, class: "btn btn-primary btn-lg" %>
    </div>
  <% end %>
</div>