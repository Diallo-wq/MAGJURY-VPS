
	
	<!--Main Footer-->
    <footer class="main-footer">
    	<div class="container">
        	<!--Widgets Section-->
            <div class="widgets-section">
            	<div class="row clearfix">
                	
                    <!--Column-->
                    <div class="big-column col-lg-6 col-md-12 col-sm-12">
						<div class="row clearfix">
						
                        	<!--Footer Column-->
                            <div class="footer-column col-lg-7 col-md-6 col-sm-12">
                                <div class="footer-widget logo-widget">
									<div class="logo">
                                        <a href="/">
											<% if SiteSetting.current.logo.attached? %>
												<%= image_tag SiteSetting.current.logo,
															alt: "Logo #{site_name}",
															style: "width:90px;"%>
											<% else %>
												<%= image_tag 'logo.jpg', alt: "Logo #{site_name}", style: "width:90px;"%>
											<% end %>
										</a>
									</div>
									<div class="text">
										<%if site_description.present?%>
										<%=raw(site_description)%>
										<%else%>
											MagJury est une plateforme citoyenne qui note et évalue les magistrats pour une justice plus transparente.
										<%end%>
										</div>
									<div class="magjury-canvas__social">
										<% %w[facebook linkedin instagram tiktok youtube twitter].each do |network| %>
											<% if SiteSetting.current.send(network).present? %>
											<%= link_to SiteSetting.current.send(network), target: "_blank", class: "mj-footer-social-link", title: network.capitalize do %>
												<i class="bi bi-<%= network == 'twitter' ? 'twitter-x' : network %>"></i>
											<% end %>
											<% end %>
										<% end %>
									</div>
								</div>
							</div>
							
							<!--Footer Column-->
                            <div class="footer-column col-lg-5 col-md-6 col-sm-12">
                                <div class="footer-widget links-widget">
									<h4>Liens rapide</h4>
									<ul class="list-link">
										<li><a href="/">Acceuil</a></li>
										<li><a href="<%=boutique_path%>">boutique</a></li>
										<li><a href="<%=emplois_path%>">Offre d'emplois</a></li>
										<li><a href="<%=magazine_path%>">Actualités</a></li>
									</ul>
								</div>
							</div>

						</div>
					</div>
					
					<!--Column-->
                    <div class="big-column col-lg-6 col-md-12 col-sm-12">
						<div class="row clearfix">
						
                        	<!--Footer Column-->
                            <div class="footer-column col-lg-6 col-md-6 col-sm-12">
                                <div class="footer-widget links-widget">
									<h4>Support</h4>
									<ul class="list-link">
										<li><a href="<%=contact_path%>">Contact</a></li>
										<li><a href="<%=offre_de_service_path%>">Services</a></li>
										<li><a href="">Support Technique</a></li>
									</ul>
								</div>
							</div>
							
							<!-- app/views/layouts/_footer.html.erb -->
								<div class="footer-column col-lg-6 col-md-6 col-sm-12">
								<div class="footer-widget gallery-widget">
									<h4>Posts récents</h4>
									<div class="widget-content">
									<div class="images-outer clearfix">
										<% @recent_posts.each do |post| %>
										<figure class="image-box">
											<a href="<%= post_path(post) %>" class="lightbox-image" data-fancybox="footer-gallery" title="<%= post.title %>">
											<%= image_tag post.cover_image.attached? ? post.cover_image : "bg-loi.jpg", class: "footer-gallery-thumb", alt: post.title %>
											</a>
										</figure>
										<% end %>
									</div>
									</div>
								</div>
								</div>
							
						</div>
					</div>
					
				</div>
			</div>
		</div>
		
		<!-- Footer Bottom -->
		<div class="footer-bottom bg-primary text-light">
			<div class="container">
				<div class="row clearfix">
					<!-- Copyright Column -->
					<div class="copyright-column col-md-12">
						<div class="copyright text-center text-light">2025 &copy; Tous droit réservé <a href="https://1kda.com/" class="text-warning">KDA BENIN</a></div>
					</div>					
				</div>
			</div>
		</div>
	</footer>